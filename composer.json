{
    "name": "vpndetection/wordpress-plugin",
    "description": "VPNDetection's WordPress plugin: block VPNs, proxies, Tor and hosting networks.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "vpndetection/vpndetection": "^4.11"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "VPNDetection\\WordPress\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.99"
        },
        "platform-check": false
    },
    "replace": {
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php82": "*"
    }
}
